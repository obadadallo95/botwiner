# A no-key public endpoint is the default. Override both when evaluating a
# dedicated provider. Never commit provider URLs containing API keys.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com/

# processed is fastest but can include transactions that are later dropped.
# Allowed values: processed, confirmed, finalized
SOLANA_COMMITMENT=processed

# Helius API Key for candidate feed comparisons (never commit the actual key)
HELIUS_API_KEY=your_helius_api_key_here

# Optional hybrid local capture telemetry. The CLI flags take precedence.
BOTWINER_TELEMETRY=none
TELEMETRY_HEARTBEAT_INTERVAL_SECONDS=60
TELEMETRY_STATS_INTERVAL_SECONDS=1800
TELEMETRY_OPERATION_TIMEOUT_MS=5000

# Dashboard: use a Firebase project that you control. These values are loaded
# at build time; no hosted Botwiner project is bundled in the source tree.
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# API / cloud runner: set these to the same project (or to your chosen
# separate project) before enabling cloud sessions or Firestore telemetry.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west3
GCS_BUCKET=your-gcs-bucket
CLOUD_RUN_JOB_NAME=your-cloud-run-job
ALLOWED_ORIGINS=http://localhost:3000
OWNER_EMAIL=you@example.com
# OWNER_UID=your-firebase-user-uid
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
