{
  "name": "botwiner-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Execution-aware Solana/Pump.fun market research with causal capture, deterministic replay, latency simulation, and a published negative result",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "collector:start": "node --import tsx apps/collector/src/main.ts",
    "replay": "node --import tsx apps/replay/src/main.ts",
    "phase2:enrich": "node --import tsx apps/phase2/src/enrich.ts",
    "phase2:rebuild": "node --import tsx apps/phase2/src/rebuild.ts",
    "phase2:quality": "node --import tsx apps/phase2/src/quality.ts",
    "comparison:run": "node --import tsx apps/comparator/src/run-comparison.ts",
    "comparison:analyze": "node --import tsx apps/comparator/src/analyze-comparison.ts",
    "simulate": "node --import tsx apps/simulator/src/main.ts",
    "filter:research": "node --import tsx apps/simulator/src/run-filters.ts",
    "pivot:audit": "node --import tsx apps/simulator/src/run-pivots.ts",
    "rebound:research": "node --import tsx apps/simulator/src/run-rebound.ts",
    "research:replay-cloud": "node --import tsx apps/replay/src/replay-cloud.ts",
    "research:demo": "node --import tsx scripts/research-demo.ts",
    "research:figures": "python3 scripts/generate-research-figures.py",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm test && pnpm lint"
  },
  "devDependencies": {
    "@botwiner/market-data": "workspace:*",
    "@botwiner/pumpfun": "workspace:*",
    "@botwiner/research": "workspace:*",
    "@botwiner/solana": "workspace:*",
    "@botwiner/storage": "workspace:*",
    "@eslint/js": "^9.35.0",
    "@types/node": "^20.19.13",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "@triton-one/yellowstone-grpc": "^7.0.1",
    "ws": "^8.18.3"
  }
}
